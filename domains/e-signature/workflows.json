      },
      "state_machine": {
        "entity": "contract",
        "initial": "draft",
        "terminal": [
          "declined",
          "voided",
          "expired",
          "archived"
        ],
        "states": [
          "draft",
          "sent",
          "in_progress",
          "completed",
          "declined",
          "voided",
          "expired",
          "archived"
