            "to": "in_progress",
            "event": "first_signature"
          },
          {
            "from": "sent",
            "to": "completed",
            "event": "complete_single_signer"
          },
          {
            "from": "in_progress",
            "to": "completed",
            "event": "last_signature"
          },
          {
            "from": "sent",
            "to": "declined",
            "event": "decline"
          },
          {
            "from": "in_progress",
            "to": "declined",
            "event": "decline"
          },
          {
            "from": "draft",
            "to": "voided",
            "event": "void"
          },
          {
            "from": "sent",
            "to": "voided",
            "event": "void"
          },
          {
            "from": "in_progress",
            "to": "voided",
            "event": "void"
          },
          {
            "from": "sent",
            "to": "expired",
            "event": "expire"
          },
          {
