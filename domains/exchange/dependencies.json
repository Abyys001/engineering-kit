      "type": "requires",
      "reason": "A till belongs to a branch."
    },
    {
      "from": "exchange.staff_management",
      "to": "exchange.branch_management",
      "type": "requires",
      "reason": "Staff are assigned to a branch."
    },
    {
      "from": "exchange.receipts_payments",
      "to": "exchange.buy_sell_transactions",
      "type": "requires",
      "reason": "A receipt documents a completed transaction."
    },
    {
      "from": "exchange.kyc_thresholds",
