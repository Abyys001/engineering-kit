      "type": "requires",
      "reason": "Reports are filed against flagged transactions."
    },
    {
      "from": "exchange.audit_log",
      "to": "exchange.buy_sell_transactions",
      "type": "requires",
      "reason": "Every transaction is written to the audit log."
    },
    {
      "from": "exchange.reports_analytics",
      "to": "exchange.buy_sell_transactions",
      "type": "requires",
      "reason": "Reports roll up completed transactions."
    },
    {
      "from": "exchange.reports_analytics",
      "to": "exchange.till_cash_management",
      "type": "enhances",
      "reason": "Cash-position history enriches branch reports."
    },
    {
      "from": "exchange.commission_management",
