    {
      "from": "exchange.rate_feed_ingestion",
      "to": "exchange.rate_management",
      "type": "enhances",
      "reason": "A feed seeds/validates rates but manual entry works without it."
    },
    {
      "from": "exchange.exchange_requests",
      "to": "exchange.customer_management",
      "type": "requires",
      "reason": "A quote request is tied to a customer record."
    },
    {
      "from": "exchange.exchange_requests",
      "to": "exchange.rate_management",
      "type": "requires",
      "reason": "A quote needs a current rate to quote against."
    },
    {
      "from": "exchange.buy_sell_transactions",
      "to": "exchange.exchange_requests",
      "type": "enhances",
      "reason": "A transaction can follow a prior quote, but a teller can also transact directly."
    },
    {
      "from": "exchange.buy_sell_transactions",
      "to": "exchange.rate_management",
      "type": "requires",
      "reason": "A transaction locks in a rate at execution time."
