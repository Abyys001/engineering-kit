      "reason": "Report filing decisions must be traceable."
    },
    {
      "from": "exchange.staff_management",
      "to": "shared.auth",
      "type": "requires",
      "reason": "Staff sign in with role-scoped access."
    },
    {
      "from": "exchange.reports_analytics",
      "to": "shared.reporting",
      "type": "enhances",
      "reason": "Domain reports surface through the shared reporting capability."
    },
    {
      "from": "exchange.notifications",
      "to": "shared.notifications",
      "type": "requires",
      "reason": "Customer alerts are delivered through the shared notification channel."
