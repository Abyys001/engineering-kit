      "name": "Night audit workflow",
      "actor": "front_desk_agent",
      "trigger": "End of the property's business day",
      "steps": [
        "Post room charges for the day to open folios",
        "Reconcile payments taken against the day's transactions",
        "Resolve no-shows and auto-cancellations",
        "Roll the business date forward"
