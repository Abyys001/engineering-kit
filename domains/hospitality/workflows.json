    {
      "id": "reservation_lifecycle",
      "name": "Reservation lifecycle",
      "actor": "guest",
      "trigger": "Guest requests one or more rooms for a date range",
      "steps": [
        "Search availability for dates and occupancy",
        "Select room type(s) and rate plan",
