      "reason": "Party profile changes are audit-logged."
    },
    {
      "from": "fintech.aml_transaction_monitoring",
      "to": "shared.audit_log",
      "type": "enhances",
      "reason": "AML case actions are audit-logged for regulatory evidence."
    },
    {
      "from": "fintech.limits_management",
      "to": "shared.audit_log",
      "type": "enhances",
      "reason": "Limit overrides are audit-logged."
    }
