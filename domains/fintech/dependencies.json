{
  "schema": 1,
  "domain": "fintech",
  "last_reviewed": "2026-09-27",
  "edges": [
    {
      "from": "fintech.kyc_onboarding",
      "to": "fintech.party_management",
      "type": "requires",
      "reason": "A KYC case is opened against an existing party record."
    },
    {
      "from": "fintech.ledger_accounts",
      "to": "fintech.party_management",
      "type": "requires",
      "reason": "Every ledger account is owned by a party."
    },
    {
      "from": "fintech.wallets",
      "to": "fintech.ledger_accounts",
      "type": "requires",
      "reason": "A wallet's balance is backed by ledger accounts/entries."
