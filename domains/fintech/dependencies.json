      "reason": "Identity documents are stored as files."
    },
    {
      "from": "fintech.statements",
      "to": "shared.file_storage",
      "type": "enhances",
      "reason": "Generated statements are stored as files (e.g. PDF)."
    },
    {
      "from": "fintech.dispute_management",
      "to": "shared.notifications",
      "type": "enhances",
      "reason": "Dispute status changes notify the customer."
    },
    {
      "from": "fintech.fraud_monitoring",
      "to": "shared.notifications",
      "type": "enhances",
      "reason": "Confirmed fraud triggers customer/staff alerts."
    },
    {
      "from": "fintech.reconciliation",
      "to": "shared.reporting",
      "type": "enhances",
      "reason": "Discrepancy reports surface through the shared reporting capability."
    },
    {
      "from": "fintech.party_management",
