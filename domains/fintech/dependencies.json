    {
      "from": "fintech.payments",
      "to": "fintech.ledger_accounts",
      "type": "requires",
      "reason": "Settling a payment posts double-entry ledger entries."
    },
    {
      "from": "fintech.internal_transfers",
      "to": "fintech.wallets",
      "type": "requires",
      "reason": "Transfers move balance between wallets."
